# Copy to .env and fill in. Never commit .env.

# ── Neo4j ─────────────────────────────────────────────
# Local (Neo4j Desktop or docker compose): bolt://localhost:7687
# AuraDB: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ── LLM (only used to parse questions + write briefs) ──
# Tried in this order; providers without a key are skipped.
# With no key at all the simulator still works (rule parser + template brief).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER_ORDER=openai,gemini,openrouter
# Optional backups:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Seconds to skip a provider after it reports quota/rate limit
LLM_COOLDOWN_SECONDS=300

# ── Live news (optional) ──────────────────────────────
# GDELT + RSS need no key. APITube adds more articles.
APITUBE_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=

# ── API ───────────────────────────────────────────────
# Comma-separated, or * for any
CORS_ORIGINS=*
